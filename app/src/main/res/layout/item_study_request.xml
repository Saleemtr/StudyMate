<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:background="@drawable/bg_card" android:elevation="1dp" android:orientation="vertical" android:padding="18dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/itemCourse" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="@color/navy" android:textSize="20sp" android:textStyle="bold" />
        <TextView android:id="@+id/itemStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/blue" android:textStyle="bold" />
    </LinearLayout>
    <TextView android:id="@+id/itemTopic" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textColor="@color/navy" android:textSize="16sp" />
    <TextView android:id="@+id/itemSchedule" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:textColor="@color/blue" android:textSize="14sp" />
</LinearLayout>
