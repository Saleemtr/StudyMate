<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.StudyMate" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorAccent">@color/blue</item>
        <item name="android:buttonStyle">@style/StudyMate.Button</item>
        <item name="android:editTextStyle">@style/StudyMate.EditText</item>
        <item name="android:spinnerStyle">@style/StudyMate.Spinner</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:statusBarColor">@color/white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/surface</item>
    </style>

    <style name="StudyMate.Button" parent="android:style/Widget.Material.Button">
        <item name="android:backgroundTint">@color/blue</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:gravity">center</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="StudyMate.Button.Secondary" parent="StudyMate.Button">
        <item name="android:backgroundTint">@color/soft_blue</item>
        <item name="android:textColor">@color/blue_dark</item>
    </style>

    <style name="StudyMate.Button.Danger" parent="StudyMate.Button">
        <item name="android:backgroundTint">@color/danger</item>
    </style>

    <style name="StudyMate.EditText" parent="android:style/Widget.Material.EditText">
        <item name="android:textColor">@color/navy</item>
        <item name="android:textColorHint">@color/slate</item>
        <item name="android:backgroundTint">@color/blue</item>
        <item name="android:minHeight">54dp</item>
        <item name="android:paddingHorizontal">8dp</item>
    </style>

    <style name="StudyMate.Spinner" parent="android:style/Widget.Material.Spinner.Underlined">
        <item name="android:backgroundTint">@color/blue</item>
        <item name="android:popupBackground">@color/white</item>
        <item name="android:paddingHorizontal">8dp</item>
    </style>
</resources>
